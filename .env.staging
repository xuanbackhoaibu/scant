# Staging Environment Configuration
ENVIRONMENT=staging
DEBUG=False
PORT=8050
HOST=0.0.0.0

# Security & Secrets (Must be supplied via cloud secret manager)
SECRET_KEY=CHANGE_ME_STAGING_STRONG_RANDOM_SECRET_KEY_MIN_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# Database
DATABASE_URL=postgresql+asyncpg://staging_user:STAGING_DB_PASSWORD@staging-db.internal:5432/ai_report_studio_staging

# Redis / Queue
REDIS_URL=redis://staging-redis.internal:6379/0

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=staging-ai-report-studio-artifacts
S3_REGION=ap-southeast-1
S3_ENDPOINT_URL=https://s3.ap-southeast-1.amazonaws.com

# AI Gateway
AI_PROVIDER_DEFAULT=gemini
AI_TEMPERATURE=0.2

# Feature Flags & Beta Mode
BETA_MODE=True
ALLOW_PUBLIC_SIGNUP=False

# Google Cloud OAuth Configuration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3050/api/auth/callback/google
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
