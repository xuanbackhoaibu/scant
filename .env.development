# Development Environment Configuration
ENVIRONMENT=development
DEBUG=True
PORT=8050
HOST=0.0.0.0

# Security & Secrets (Development keys)
SECRET_KEY=dev_insecure_secret_key_change_in_production_123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Local SQLite for fast testing / PostgreSQL local)
DATABASE_URL=sqlite+aiosqlite:///./sql_app.db
# PostgreSQL Alternative: postgresql+asyncpg://postgres:postgres@localhost:5432/ai_report_studio_dev

# Redis / Queue
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=apps/storage

# AI Gateway Defaults
AI_PROVIDER_DEFAULT=mock
AI_TEMPERATURE=0.3

# Feature Flags
BETA_MODE=False
ALLOW_PUBLIC_SIGNUP=True
