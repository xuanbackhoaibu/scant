# Production Environment Configuration
ENVIRONMENT=production
DEBUG=False
PORT=8050
HOST=0.0.0.0

# Security & Secrets (Must be supplied via cloud secret manager)
SECRET_KEY=CHANGE_ME_PRODUCTION_STRONG_RANDOM_SECRET_KEY_MIN_32_BYTES
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
DATABASE_URL=postgresql+asyncpg://prod_user:PROD_DB_PASSWORD@prod-db-primary.internal:5432/ai_report_studio_prod

# Redis / Queue
REDIS_URL=redis://prod-redis-cluster.internal:6379/0

# Storage
STORAGE_PROVIDER=s3
S3_BUCKET_NAME=prod-ai-report-studio-artifacts
S3_REGION=ap-southeast-1

# AI Gateway
AI_PROVIDER_DEFAULT=gemini
AI_TEMPERATURE=0.2

# Feature Flags
BETA_MODE=False
ALLOW_PUBLIC_SIGNUP=True
